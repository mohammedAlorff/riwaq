# رواق — مجلد رفع الصور
# اسمح فقط بتقديم الصور؛ لا تشغّل أي سكربتات.

<FilesMatch "(?i)^(?!.*\.(?:jpg|jpeg|png|webp|gif)$)">
    Require all denied
</FilesMatch>

# اسمح بالصور المعروفة
<FilesMatch "(?i)\.(jpg|jpeg|png|webp|gif)$">
    SetHandler none
    Require all granted
</FilesMatch>

# عطّل تنفيذ السكربتات في هذا المجلد
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
Options -ExecCGI -Indexes
AddType text/plain .php .phtml .phar
