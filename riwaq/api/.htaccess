# رواق — API
# يمنع الوصول المباشر إلى ملفات المساعدة والإعدادات وملفات SQL.

# التهيئة من سطر الأوامر فقط.
<FilesMatch "^(setup|db|helpers|auth_helpers|config(?:\..*)?)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md|example\.php)$">
    Require all denied
</FilesMatch>

# اضبط الترميز
AddDefaultCharset UTF-8

# لا تكشف نسخة الخادم
ServerSignature Off

# لا تسمح بفهرسة المجلد
Options -Indexes
